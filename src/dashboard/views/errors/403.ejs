<%- include('../layouts/main', { title: 'Forbidden', body: `
<div class="min-h-[60vh] flex items-center justify-center">
  <div class="text-center">
    <div class="w-24 h-24 mx-auto mb-6 bg-yellow-500/20 rounded-full flex items-center justify-center">
      <i class="fas fa-lock text-4xl text-yellow-500"></i>
    </div>
    <h1 class="text-4xl font-bold text-white mb-4">403</h1>
    <p class="text-xl text-gray-400 mb-8">Forbidden</p>
    <p class="text-gray-500 mb-8 max-w-md mx-auto"><%= message || 'You don\'t have permission to access this page.' %></p>
    <div class="flex items-center justify-center space-4">
      <a href="/guilds" class="px-6 py-3 bg-primary hover:bg-primary-hover text-white font-medium rounded-lg transition-colors">
        <i class="fas fa-home mr-2"></i> Dashboard
      </a>
      <button onclick="history.back()" class="px-6 py-3 border border-discord-border hover:bg-discord-card text-white font-medium rounded-lg transition-colors">
        <i class="fas fa-arrow-left mr-2"></i> Go Back
      </button>
    </div>
  </div>
</div>
` }) %>