<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - StellarSentry</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-900 text-white min-h-screen">
    <nav class="bg-gray-800 border-b border-gray-700">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex items-center">
                    <a href="/guilds" class="text-xl font-bold text-purple-400">StellarSentry</a>
                </div>
                <div class="flex items-center space-x-4">
                    <a href="/guilds" class="text-gray-300 hover:text-white">Dashboard</a>
                    <a href="/auth/logout" class="bg-purple-600 hover:bg-purple-700 text-white px-4 py-2 rounded-lg">Logout</a>
                </div>
            </div>
        </div>
    </nav>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="flex justify-between items-center mb-8">
            <div>
                <h1 class="text-3xl font-bold text-white">Commands</h1>
                <p class="text-gray-400"><%= guild.name %> - Manage bot commands</p>
            </div>
        </div>

        <div class="bg-gray-800 rounded-xl border border-gray-700 overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead class="bg-gray-700">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-300 uppercase tracking-wider">Command</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-300 uppercase tracking-wider">Description</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-300 uppercase tracking-wider">Category</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-300 uppercase tracking-wider">Status</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-300 uppercase tracking-wider">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="bg-gray-800 divide-y divide-gray-700">
                        <% commands.forEach(cmd => { %>
                            <tr class="hover:bg-gray-700">
                                <td class="px-6 py-4">
                                    <div class="text-sm font-medium text-white"><%= cmd.name %></div>
                                </td>
                                <td class="px-6 py-4">
                                    <div class="text-sm text-gray-300 max-w-xs truncate"><%= cmd.description %></div>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-900 text-purple-200"><%= cmd.category || 'General' %></span>
                                </td>
                                <td class="px-6 py-4">
                                    <% if (cmd.enabled) { %>
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-900 text-green-200">Enabled</span>
                                    <% } else { %>
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-900 text-red-200">Disabled</span>
                                    <% } %>
                                </td>
                                <td class="px-6 py-4">
                                    <button
                                        class="toggle-cmd px-3 py-1.5 text-xs font-medium rounded-lg transition-colors
                                            <%= cmd.enabled ? 'bg-red-600 hover:bg-red-700' : 'bg-green-600 hover:bg-green-700' %>"
                                        data-cmd="<%= cmd.name %>"
                                        data-enabled="<%= cmd.enabled %>"
                                        data-csrf="<%= csrfToken %>">
                                        <%= cmd.enabled ? 'Disable' : 'Enable' %>
                                    </button>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <footer class="bg-gray-800 border-t border-gray-700 py-8">
        <div class="max-w-7xl mx-auto px-4 text-center text-gray-500">
            <p>StellarSentry - Discord Bot with Dashboard</p>
        </div>
    </footer>

    <script>
        document.querySelectorAll('.toggle-cmd').forEach(btn => {
            btn.addEventListener('click', async () => {
                const cmd = btn.dataset.cmd;
                const enabled = btn.dataset.enabled === 'true';

                try {
                    const res = await fetch(`/commands/<%= guild.id %>/toggle`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-CSRF-Token': btn.dataset.csrf
                        },
                        body: JSON.stringify({ command: cmd, enabled: !enabled })
                    });

                    const data = await res.json();
                    if (data.success) {
                        location.reload();
                    } else {
                        alert('Failed to toggle command: ' + data.error);
                    }
                } catch (err) {
                    console.error(err);
                    alert('An error occurred');
                }
            });
        });
    </script>
</body>
</html>