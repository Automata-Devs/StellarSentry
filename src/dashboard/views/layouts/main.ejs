<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="StellarSentry - Discord Bot with Web Dashboard">
  <title><%= title || 'StellarSentry' %></title>

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            primary: '#5865F2',
            'primary-hover': '#4752C4',
            'discord-dark': '#1e1f22',
            'discord-darker': '#18191c',
            'discord-card': '#2b2d31',
            'discord-border': '#3e3f43',
          },
        },
      },
    }
  </script>

  <!-- Alpine.js -->
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <!-- Custom CSS -->
  <link rel="stylesheet" href="/static/css/output.css">

  <style>
    /* Custom scrollbar */
    ::-webkit-scrollbar { width: 8px; height: 8px; }
    ::-webkit-scrollbar-track { background: #1e1f22; }
    ::-webkit-scrollbar-thumb { background: #3e3f43; border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: #4e4f54; }

    /* Animations */
    @keyframes fadeIn { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: translateY(0); } }
    @keyframes slideIn { from { opacity: 0; transform: translateX(-20px); } to { opacity: 1; transform: translateX(0); } }
    .animate-fade-in { animation: fadeIn 0.3s ease-out; }
    .animate-slide-in { animation: slideIn 0.3s ease-out; }

    /* Focus styles */
    .focus-ring:focus { outline: none; ring: 2px; ring-color: #5865F2; ring-offset: 2px; ring-offset-color: #1e1f22; }

    /* Toast animations */
    .toast-enter { animation: slideIn 0.3s ease-out; }
    .toast-exit { animation: fadeIn 0.2s ease-in reverse; }

    /* Starfield background */
    .starfield { position: fixed; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: -1; overflow: hidden; }
    .star { position: absolute; background: white; border-radius: 50%; animation: twinkle 2s infinite ease-in-out; }
    @keyframes twinkle { 0%, 100% { opacity: 0.3; transform: scale(1); } 50% { opacity: 1; transform: scale(1.5); } }

    /* Glow effects */
    .glow-primary { box-shadow: 0 0 20px rgba(88, 101, 242, 0.3); }
    .glow-primary:hover { box-shadow: 0 0 30px rgba(88, 101, 242, 0.5); }
  </style>
</head>
<body class="bg-discord-darker text-white min-h-screen dark" x-data="{ sidebarOpen: false, toasts: [] }">
  <!-- Starfield background -->
  <div class="starfield" id="starfield"></div>

  <!-- Mobile sidebar overlay -->
  <div x-show="sidebarOpen" x-transition:enter="transition-opacity ease-in-out duration-200" x-transition:leave="transition-opacity ease-out duration-200" class="fixed inset-0 bg-black/50 z-40 lg:hidden" @click="sidebarOpen = false" aria-hidden="true"></div>

  <!-- Sidebar -->
  <aside x-show="sidebarOpen" x-transition:enter="transition ease-in-out duration-300" x-transition:leave="transition ease-out duration-300" class="fixed inset-y-0 left-0 z-50 w-64 bg-discord-dark border-r border-discord-border transform -translate-x-full lg:translate-x-0 lg:static lg:z-auto" role="navigation" aria-label="Main navigation">
    <div class="flex flex-col h-full">
      <!-- Logo -->
      <div class="flex items-center justify-between h-16 px-4 border-b border-discord-border">
        <a href="/" class="flex items-center space-2">
          <div class="w-8 h-8 rounded-lg bg-primary flex items-center justify-center glow-primary">
            <i class="fas fa-star text-white text-lg"></i>
          </div>
          <span class="font-bold text-xl text-white">StellarSentry</span>
        </a>
        <button @click="sidebarOpen = false" class="lg:hidden p-2 rounded-lg hover:bg-discord-card transition-colors" aria-label="Close sidebar">
          <i class="fas fa-times text-gray-400"></i>
        </button>
      </div>

      <!-- Navigation -->
      <nav class="flex-1 overflow-y-auto p-4 space-y-1" role="navigation" aria-label="Dashboard sections">
        <% if (user) { %>
          <!-- Dashboard -->
          <a href="/guilds" class="flex items-center space-3 px-3 py-2.5 rounded-lg text-gray-400 hover:text-white hover:bg-discord-card transition-colors">
            <i class="fas fa-tachometer-alt w-5 h-5"></i>
            <span>Dashboard</span>
          </a>

          <!-- Servers -->
          <a href="/guilds" class="flex items-center space-3 px-3 py-2.5 rounded-lg text-gray-400 hover:text-white hover:bg-discord-card transition-colors">
            <i class="fas fa-server w-5 h-5"></i>
            <span>Servers</span>
          </a>

          <hr class="border-discord-border my-2">

          <!-- Bot Settings -->
          <div x-data="{ open: false }">
            <button @click="open = !open" class="w-full flex items-center justify-between px-3 py-2.5 rounded-lg text-gray-400 hover:text-white hover:bg-discord-card transition-colors">
              <span class="flex items-center space-3">
                <i class="fas fa-cog w-5 h-5"></i>
                <span>Bot Settings</span>
              </span>
              <i class="fas fa-chevron-down text-xs transition-transform duration-200" :class="{ 'rotate-180': open }"></i>
            </button>
            <div x-show="open" x-transition:enter="transition ease-out duration-200" x-transition:leave="transition ease-in duration-150" class="mt-1 space-y-1 pl-8">
              <a href="#" class="flex items-center space-3 px-3 py-2 rounded-lg text-gray-400 hover:text-white hover:bg-discord-card/50 transition-colors text-sm">
                <i class="fas fa-shield-alt w-5 h-5"></i>
                <span>Moderation</span>
              </a>
              <a href="#" class="flex items-center space-3 px-3 py-2 rounded-lg text-gray-400 hover:text-white hover:bg-discord-card/50 transition-colors text-sm">
                <i class="fas fa-chart-line w-5 h-5"></i>
                <span>Leveling</span>
              </a>
              <a href="#" class="flex items-center space-3 px-3 py-2 rounded-lg text-gray-400 hover:text-white hover:bg-discord-card/50 transition-colors text-sm">
                <i class="fas fa-coins w-5 h-5"></i>
                <span>Economy</span>
              </a>
              <a href="#" class="flex items-center space-3 px-3 py-2 rounded-lg text-gray-400 hover:text-white hover:bg-discord-card/50 transition-colors text-sm">
                <i class="fas fa-ticket-alt w-5 h-5"></i>
                <span>Tickets</span>
              </a>
              <a href="#" class="flex items-center space-3 px-3 py-2 rounded-lg text-gray-400 hover:text-white hover:bg-discord-card/50 transition-colors text-sm">
                <i class="fas fa-gift w-5 h-5"></i>
                <span>Giveaways</span>
              </a>
              <a href="#" class="flex items-center space-3 px-3 py-2 rounded-lg text-gray-400 hover:text-white hover:bg-discord-card/50 transition-colors text-sm">
                <i class="fas fa-lightbulb w-5 h-5"></i>
                <span>Suggestions</span>
              </a>
              <a href="#" class="flex items-center space-3 px-3 py-2 rounded-lg text-gray-400 hover:text-white hover:bg-discord-card/50 transition-colors text-sm">
                <i class="fas fa-star w-5 h-5"></i>
                <span>Starboard</span>
              </a>
              <a href="#" class="flex items-center space-3 px-3 py-2 rounded-lg text-gray-400 hover:text-white hover:bg-discord-card/50 transition-colors text-sm">
                <i class="fas fa-music w-5 h-5"></i>
                <span>Music</span>
              </a>
              <a href="#" class="flex items-center space-3 px-3 py-2 rounded-lg text-gray-400 hover:text-white hover:bg-discord-card/50 transition-colors text-sm">
                <i class="fas fa-comments w-5 h-5"></i>
                <span>Logging</span>
              </a>
            </div>
          </div>
        <% } else { %>
          <a href="/features" class="flex items-center space-3 px-3 py-2.5 rounded-lg text-gray-400 hover:text-white hover:bg-discord-card transition-colors">
            <i class="fas fa-star w-5 h-5"></i>
            <span>Features</span>
          </a>
          <a href="/docs" class="flex items-center space-3 px-3 py-2.5 rounded-lg text-gray-400 hover:text-white hover:bg-discord-card transition-colors">
            <i class="fas fa-book w-5 h-5"></i>
            <span>Documentation</span>
          </a>
          <a href="/support" class="flex items-center space-3 px-3 py-2.5 rounded-lg text-gray-400 hover:text-white hover:bg-discord-card transition-colors">
            <i class="fas fa-headset w-5 h-5"></i>
            <span>Support</span>
          </a>
        <% } %>
      </nav>

      <!-- User menu / Login -->
      <div class="p-4 border-t border-discord-border">
        <% if (user) { %>
          <div class="flex items-center space-3">
            <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png?size=32" alt="" class="w-8 h-8 rounded-full">
            <div class="flex-1 min-w-0">
              <p class="text-sm font-medium text-white truncate"><%= user.username %></p>
              <p class="text-xs text-gray-500 truncate">#<%= user.discriminator %></p>
            </div>
          </div>
          <div class="mt-3 space-y-1">
            <a href="/guilds" class="block px-3 py-2 rounded-lg text-gray-400 hover:text-white hover:bg-discord-card transition-colors text-sm">
              <i class="fas fa-cog mr-2"></i> Settings
            </a>
            <a href="/auth/logout" class="block px-3 py-2 rounded-lg text-gray-400 hover:text-white hover:bg-discord-card transition-colors text-sm">
              <i class="fas fa-sign-out-alt mr-2"></i> Logout
            </a>
          </div>
        <% } else { %>
          <a href="/auth/login" class="block w-full text-center px-4 py-2.5 bg-primary hover:bg-primary-hover text-white font-medium rounded-lg transition-colors">
            <i class="fab fa-discord mr-2"></i> Login with Discord
          </a>
        <% } %>
      </div>
    </div>
  </aside>

  <!-- Main content -->
  <main class="lg:ml-64 min-h-screen">
    <!-- Top bar -->
    <header class="sticky top-0 z-30 bg-discord-dark/95 backdrop-blur-sm border-b border-discord-border">
      <div class="flex items-center justify-between h-16 px-4 lg:px-8">
        <div class="flex items-center space-4">
          <button @click="sidebarOpen = true" class="lg:hidden p-2 rounded-lg hover:bg-discord-card transition-colors" aria-label="Open sidebar">
            <i class="fas fa-bars text-gray-400"></i>
          </button>
          <h1 class="text-lg font-semibold text-white"><%= title %></h1>
        </div>

        <div class="flex items-center space-4">
          <!-- Notifications -->
          <div class="relative">
            <button class="relative p-2 rounded-lg hover:bg-discord-card transition-colors" aria-label="Notifications">
              <i class="fas fa-bell text-gray-400 text-xl"></i>
              <span class="absolute -top-1 -right-1 w-5 h-5 bg-red-500 text-white text-xs font-medium rounded-full flex items-center justify-center">3</span>
            </button>
          </div>

          <% if (user) { %>
            <div class="flex items-center space-3">
              <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png?size=32" alt="" class="w-8 h-8 rounded-full border border-discord-border">
            </div>
          <% } %>
        </div>
      </div>
    </header>

    <!-- Flash messages -->
    <% if (locals.messages) { %>
      <div class="fixed top-20 right-4 z-50 space-y-2" x-data="{ toasts: <%= JSON.stringify(locals.messages) %> }">
        <template x-for="toast in toasts" :key="toast.type + toast.message">
          <div x-show="toast.visible" x-transition:enter="transition ease-out duration-300" x-transition:leave="transition ease-in duration-200" class="toast-enter min-w-[300px] max-w-md px-4 py-3 rounded-lg shadow-lg border flex items-start space-3" :class="toast.type === 'success' ? 'bg-green-900/90 border-green-500' : toast.type === 'error' ? 'bg-red-900/90 border-red-500' : 'bg-blue-900/90 border-blue-500'">
            <div class="flex-1">
              <p class="font-medium"><%= toast.type === 'success' ? 'Success' : toast.type === 'error' ? 'Error' : 'Info' %></p>
              <p class="text-sm text-gray-300 mt-1"><%= toast.message %></p>
            </div>
            <button @click="toast.visible = false" class="text-gray-400 hover:text-white p-1">
              <i class="fas fa-times"></i>
            </button>
          </div>
        </template>
      </div>
    <% } %>

    <!-- Page content -->
    <div class="p-4 lg:p-8">
      <%- body %>
    </div>
  </main>

  <!-- Scripts -->
  <script>
    // Initialize starfield
    document.addEventListener('DOMContentLoaded', () => {
      const starfield = document.getElementById('starfield');
      if (starfield) {
        for (let i = 0; i < 50; i++) {
          const star = document.createElement('div');
          star.className = 'star';
          star.style.width = `${Math.random() * 2 + 1}px`;
          star.style.height = star.style.width;
          star.style.left = `${Math.random() * 100}%`;
          star.style.top = `${Math.random() * 100}%`;
          star.style.animationDelay = `${Math.random() * 2}s`;
          starfield.appendChild(star);
        }
      }
    });

    // Global toast function
    window.showToast = function(type, message) {
      // Implementation would add to Alpine toasts
      console.log(`Toast: ${type} - ${message}`);
    };
  </script>
</body>
</html>