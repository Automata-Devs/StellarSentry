<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - StellarSentry</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-900 text-white min-h-screen">
    <nav class="bg-gray-800 border-b border-gray-700">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex items-center">
                    <a href="/guilds" class="text-xl font-bold text-purple-400">StellarSentry</a>
                    <span class="mx-2 text-gray-500">/</span>
                    <a href="/overview/<%= guild.id %>" class="text-purple-400 font-semibold"><%= guild.name %></a>
                    <span class="mx-2 text-gray-500">/</span>
                    <span class="text-gray-300">Suggestions</span>
                </div>
                <div class="flex items-center space-x-4">
                    <a href="/guilds" class="text-gray-300 hover:text-white">Dashboard</a>
                    <a href="/auth/logout" class="bg-purple-600 hover:bg-purple-700 text-white px-4 py-2 rounded-lg">Logout</a>
                </div>
            </div>
        </div>
    </nav>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="flex justify-between items-center mb-8">
            <div>
                <h1 class="text-3xl font-bold text-white"><%= guild.name %></h1>
                <p class="text-gray-400">Suggestion System</p>
            </div>
            <div class="flex space-x-2">
                <a href="/overview/<%= guild.id %>" class="bg-gray-700 hover:bg-gray-600 text-white px-4 py-2 rounded-lg">Overview</a>
                <a href="/settings/<%= guild.id %>" class="bg-gray-700 hover:bg-gray-600 text-white px-4 py-2 rounded-lg">Settings</a>
            </div>
        </div>

        <div class="bg-gray-800 rounded-xl p-6 border border-gray-700 mb-8">
            <h2 class="text-xl font-semibold text-white mb-6">Suggestion Settings</h2>
            <form id="suggestionSettingsForm" class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <div>
                    <label class="flex items-center">
                        <input type="checkbox" name="enabled" value="true" <%= suggestions?.enabled ? 'checked' : '' %>
                               class="h-4 w-4 text-purple-600 border-gray-600 rounded focus:ring-purple-500 bg-gray-700">
                        <span class="ml-2 text-sm text-gray-300">Enable Suggestions</span>
                    </label>
                </div>

                <div>
                    <label for="channel" class="block text-sm font-medium text-gray-300 mb-2">Suggestions Channel</label>
                    <input type="text" id="channel" name="channel"
                           value="<%= suggestions?.channel || '' %>"
                           class="w-full bg-gray-700 border border-gray-600 rounded-lg px-4 py-2 text-white placeholder-gray-400 focus:border-purple-500 focus:outline-none focus:ring-1 focus:ring-purple-500"
                           placeholder="Channel ID">
                </div>

                <div>
                    <label for="threadChannel" class="block text-sm font-medium text-gray-300 mb-2">Thread Channel (for discussion)</label>
                    <input type="text" id="threadChannel" name="threadChannel"
                           value="<%= suggestions?.threadChannel || '' %>"
                           class="w-full bg-gray-700 border border-gray-600 rounded-lg px-4 py-2 text-white placeholder-gray-400 focus:border-purple-500 focus:outline-none focus:ring-1 focus:ring-purple-500"
                           placeholder="Channel ID">
                </div>

                <div>
                    <label for="upvoteEmoji" class="block text-sm font-medium text-gray-300 mb-2">Upvote Emoji</label>
                    <input type="text" id="upvoteEmoji" name="upvoteEmoji"
                           value="<%= suggestions?.upvoteEmoji || '👍' %>"
                           class="w-full bg-gray-700 border border-gray-600 rounded-lg px-4 py-2 text-white placeholder-gray-400 focus:border-purple-500 focus:outline-none focus:ring-1 focus:ring-purple-500"
                           placeholder="👍">
                </div>

                <div>
                    <label for="downvoteEmoji" class="block text-sm font-medium text-gray-300 mb-2">Downvote Emoji</label>
                    <input type="text" id="downvoteEmoji" name="downvoteEmoji"
                           value="<%= suggestions?.downvoteEmoji || '👎' %>"
                           class="w-full bg-gray-700 border border-gray-600 rounded-lg px-4 py-2 text-white placeholder-gray-400 focus:border-purple-500 focus:outline-none focus:ring-1 focus:ring-purple-500"
                           placeholder="👎">
                </div>

                <div>
                    <label for="threshold" class="block text-sm font-medium text-gray-300 mb-2">Threshold for Review</label>
                    <input type="number" id="threshold" name="threshold" min="0" value="<%= suggestions?.threshold || 5 %>"
                           class="w-full bg-gray-700 border border-gray-600 rounded-lg px-4 py-2 text-white placeholder-gray-400 focus:border-purple-500 focus:outline-none focus:ring-1 focus:ring-purple-500">
                </div>

                <div class="md:col-span-2 flex justify-end">
                    <button type="submit" class="bg-purple-600 hover:bg-purple-700 text-white px-6 py-2 rounded-lg font-medium transition-colors">Save Settings</button>
                </div>
            </form>
        </div>

        <div class="bg-gray-800 rounded-xl p-6 border border-gray-700">
            <div class="flex items-center justify-between mb-6">
                <h2 class="text-xl font-semibold text-white">Recent Suggestions</h2>
                <div class="flex space-x-2">
                    <button id="refreshBtn" class="bg-gray-700 hover:bg-gray-600 text-white px-4 py-2 rounded-lg">Refresh</button>
                </div>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead>
                        <tr class="text-left text-gray-400 border-b border-gray-700">
                            <th class="pb-3 px-2">ID</th>
                            <th class="pb-3 px-2">Content</th>
                            <th class="pb-3 px-2">Author</th>
                            <th class="pb-3 px-2">Status</th>
                            <th class="pb-3 px-2">Votes</th>
                            <th class="pb-3 px-2">Created</th>
                            <th class="pb-3 px-2">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-700">
                        <% if (suggestionsList && suggestionsList.length > 0) { %>
                            <% suggestionsList.forEach(suggestion => { %>
                                <tr class="hover:bg-gray-700">
                                    <td class="py-3 px-2 font-mono text-purple-400">#<%= suggestion.suggestionId %></td>
                                    <td class="py-3 px-2 max-w-xs truncate"><%= suggestion.content %></td>
                                    <td class="py-3 px-2"><%= suggestion.author?.username || 'Unknown' %></td>
                                    <td class="py-3 px-2">
                                        <span class="px-2 py-1 rounded text-xs font-medium
                                            <%= suggestion.status === 'pending' ? 'bg-yellow-900 text-yellow-300' : '' %>
                                            <%= suggestion.status === 'approved' ? 'bg-green-900 text-green-300' : '' %>
                                            <%= suggestion.status === 'denied' ? 'bg-red-900 text-red-300' : '' %>
                                            <%= suggestion.status === 'implemented' ? 'bg-blue-900 text-blue-300' : '' %>
                                            <%= suggestion.status === 'under_review' ? 'bg-purple-900 text-purple-300' : '' %>
                                        "><%= suggestion.status %></span>
                                    </td>
                                    <td class="py-3 px-2">
                                        <span class="text-green-400">▲ <%= suggestion.upvotes?.length || 0 %></span>
                                        <span class="text-red-400 ml-2">▼ <%= suggestion.downvotes?.length || 0 %></span>
                                    </td>
                                    <td class="py-3 px-2 text-sm text-gray-400"><%= new Date(suggestion.createdAt).toLocaleDateString() %></td>
                                    <td class="py-3 px-2">
                                        <a href="/suggestions/<%= guild.id %>/<%= suggestion.suggestionId %>" class="text-purple-400 hover:text-purple-300 text-sm">View</a>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="7" class="py-8 text-center text-gray-500">No suggestions found</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <footer class="bg-gray-800 border-t border-gray-700 py-8">
        <div class="max-w-7xl mx-auto px-4 text-center text-gray-500">
            <p>StellarSentry - Discord Bot with Dashboard</p>
        </div>
    </footer>

    <script>
        const guildId = '<%= guild.id %>';
        const csrfToken = '<%= csrfToken %>';

        document.getElementById('suggestionSettingsForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(e.target);
            const data = {};
            formData.forEach((value, key) => {
                if (key !== '_csrf') data[key] = value === 'true' || value === 'on' ? true : value;
            });
            data.threshold = parseInt(data.threshold) || 0;

            try {
                const response = await fetch(`/suggestions/${guildId}/settings`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-Token': csrfToken
                    },
                    body: JSON.stringify(data)
                });
                const result = await response.json();
                if (result.success) {
                    alert('Settings saved!');
                    location.reload();
                } else {
                    alert('Failed: ' + (result.error || 'Unknown error'));
                }
            } catch (err) {
                alert('Error: ' + err.message);
            }
        });

        document.getElementById('refreshBtn')?.addEventListener('click', () => location.reload());
    </script>
</body>
</html>