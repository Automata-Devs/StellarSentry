{
  "name": "stellarsentry",
  "version": "1.0.0",
  "description": "StellarSentry — A production-ready multi-purpose Discord bot with web dashboard",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "build:css": "tailwindcss -i ./src/dashboard/public/css/input.css -o ./src/dashboard/public/css/output.css --minify",
    "build:css:dev": "tailwindcss -i ./src/dashboard/public/css/input.css -o ./src/dashboard/public/css/output.css --watch",
    "deploy:commands": "node scripts/deploy-commands.js",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky install",
    "seed": "node scripts/seed.js"
  },
  "keywords": [
    "discord",
    "bot",
    "dashboard",
    "stellarsentry",
    "discord.js"
  ],
  "author": "Automata Devs",
  "license": "MIT",
  "dependencies": {
    "@discordjs/builders": "^1.8.2",
    "@discordjs/collection": "^2.1.1",
    "@discordjs/rest": "^2.3.0",
    "@discordjs/voice": "^0.17.0",
    "@napi-rs/canvas": "^0.1.65",
    "alpinejs": "^3.14.1",
    "connect-mongo": "^5.1.0",
    "discord-api-types": "^0.37.83",
    "discord.js": "^14.15.3",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "express-session": "^1.18.0",
    "helmet": "^7.1.0",
    "lavalink-client": "^4.4.0",
    "mongoose": "^8.4.0",
    "node-cron": "^3.0.3",
    "passport": "^0.7.0",
    "passport-discord": "^0.1.4",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.3.0",
    "eslint": "^9.3.0",
    "globals": "^15.3.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.5",
    "nodemon": "^3.1.1",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.3",
    "vitest": "^1.6.0",
    "@vitest/coverage-v8": "^1.6.0"
  }
}