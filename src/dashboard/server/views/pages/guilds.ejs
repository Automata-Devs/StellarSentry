<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - StellarSentry</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-900 text-white min-h-screen">
    <nav class="bg-gray-800 border-b border-gray-700">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex items-center">
                    <a href="/" class="text-xl font-bold text-purple-400">StellarSentry</a>
                </div>
                <div class="flex items-center space-x-4">
                    <a href="/guilds" class="text-purple-400 font-semibold">Your Servers</a>
                    <% if (user) { %>
                        <span class="text-gray-400 mx-2">|</span>
                        <a href="/auth/logout" class="bg-purple-600 hover:bg-purple-700 text-white px-4 py-2 rounded-lg">Logout</a>
                    <% } else { %>
                        <a href="/auth/login" class="bg-purple-600 hover:bg-purple-700 text-white px-4 py-2 rounded-lg">Login</a>
                    <% } %>
                </div>
            </div>
        </div>
    </nav>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="flex justify-between items-center mb-8">
            <h1 class="text-3xl font-bold text-white">Your Servers</h1>
            <% if (unaddedGuilds && unaddedGuilds.length > 0) { %>
                <a href="/invite" class="bg-purple-600 hover:bg-purple-700 text-white px-4 py-2 rounded-lg">Add Bot to More Servers</a>
            <% } %>
        </div>

        <% if (error && error.length > 0) { %>
            <div class="bg-red-900/30 border border-red-700 rounded-lg p-4 mb-6">
                <p class="text-red-300"><%= error %></p>
            </div>
        <% } %>

        <% if (guilds && guilds.length > 0) { %>
            <h2 class="text-xl font-semibold text-white mb-4">Servers with Bot</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
                <% guilds.forEach(guild => { %>
                    <div class="bg-gray-800 rounded-xl p-6 border border-gray-700 hover:border-purple-500 transition-colors">
                        <div class="flex items-center space-x-4">
                            <% if (guild.icon) { %>
                                <img src="<%= guild.icon %>" alt="<%= guild.name %>" class="w-12 h-12 rounded-full">
                            <% } else { %>
                                <div class="w-12 h-12 rounded-full bg-gray-700 flex items-center justify-center text-gray-500">
                                    <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93c-3.94-.49-7-3.85-7-7.93a9.96 9.96 0 012.58-6.92L3 4v3h2V3h2v3l.49-2.58C9.57 5.17 13.53 8 17.5 8c2.35 0 4.52-.64 6.23-1.75l-.49 2.58H21v-2h-2V3h2v3l.49-2.58C19.64 1.13 16.26 0 12.5 0 6.96 0 2 4.96 2 10.5c0 4.1 3.08 7.46 7 7.93v-2.02c-1.34-.41-2.5-1.23-3.37-2.41L9 6v1c0 1.1.9 2 2 2v1.93c-1.14.22-2.24.55-3.3 1.0z"/></svg>
                                </div>
                            <% } %>
                            <div class="flex-1 min-w-0">
                                <h3 class="text-lg font-semibold text-white truncate"><%= guild.name %></h3>
                                <p class="text-gray-400 text-sm"><%= guild.memberCount %> members</p>
                            </div>
                            <a href="/overview/<%= guild.id %>" class="bg-purple-600 hover:bg-purple-700 text-white px-4 py-2 rounded-lg text-sm transition-colors">Manage</a>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="bg-gray-800 rounded-xl p-8 border border-gray-700 text-center">
                <p class="text-gray-400 mb-4">The bot is not in any servers you can manage.</p>
                <a href="/invite" class="bg-purple-600 hover:bg-purple-700 text-white px-6 py-3 rounded-lg">Invite Bot to a Server</a>
            </div>
        <% } %>

        <% if (unaddedGuilds && unaddedGuilds.length > 0) { %>
            <h2 class="text-xl font-semibold text-white mb-4 mt-12">Servers without Bot</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <% unaddedGuilds.forEach(guild => { %>
                    <div class="bg-gray-800 rounded-xl p-6 border border-gray-700">
                        <div class="flex items-center space-x-4">
                            <% if (guild.icon) { %>
                                <img src="<%= guild.icon %>" alt="<%= guild.name %>" class="w-12 h-12 rounded-full">
                            <% } else { %>
                                <div class="w-12 h-12 rounded-full bg-gray-700 flex items-center justify-center text-gray-500">
                                    <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93c-3.94-.49-7-3.85-7-7.93a9.96 9.96 0 012.58-6.92L3 4v3h2V3h2v3l.49-2.58C9.57 5.17 13.53 8 17.5 8c2.35 0 4.52-.64 6.23-1.75l-.49 2.58H21v-2h-2V3h2v3l.49-2.58C19.64 1.13 16.26 0 12.5 0 6.96 0 2 4.96 2 10.5c0 4.1 3.08 7.46 7 7.93v-2.02c-1.34-.41-2.5-1.23-3.37-2.41L9 6v1c0 1.1.9 2 2 2v1.93c-1.14.22-2.24.55-3.3 1.0z"/></svg>
                                </div>
                            <% } %>
                            <div class="flex-1 min-w-0">
                                <h3 class="text-lg font-semibold text-white truncate"><%= guild.name %></h3>
                                <p class="text-gray-400 text-sm"><%= guild.memberCount %> members</p>
                            </div>
                            <a href="https://discord.com/oauth2/authorize?client_id=<%= process.env.DISCORD_CLIENT_ID %>&permissions=8&scope=bot%20applications.commands&guild_id=<%= guild.id %>" target="_blank" class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg text-sm transition-colors">Add Bot</a>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </main>

    <footer class="bg-gray-800 border-t border-gray-700 py-8">
        <div class="max-w-7xl mx-auto px-4 text-center text-gray-500">
            <p>StellarSentry - Discord Bot with Dashboard</p>
        </div>
    </footer>
</body>
</html>