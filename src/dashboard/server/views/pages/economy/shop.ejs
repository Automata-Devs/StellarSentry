<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - StellarSentry</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-900 text-white min-h-screen">
    <nav class="bg-gray-800 border-b border-gray-700">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex items-center">
                    <a href="/guilds" class="text-xl font-bold text-purple-400">StellarSentry</a>
                    <span class="mx-2 text-gray-500">/</span>
                    <a href="/overview/<%= guild.id %>" class="text-purple-400 font-semibold"><%= guild.name %></a>
                    <span class="mx-2 text-gray-500">/</span>
                    <a href="/economy/<%= guild.id %>" class="text-gray-400 hover:text-white">Economy</a>
                    <span class="mx-2 text-gray-500">/</span>
                    <span class="text-gray-300">Shop</span>
                </div>
                <div class="flex items-center space-x-4">
                    <a href="/guilds" class="text-gray-300 hover:text-white">Dashboard</a>
                    <a href="/auth/logout" class="bg-purple-600 hover:bg-purple-700 text-white px-4 py-2 rounded-lg">Logout</a>
                </div>
            </div>
        </div>
    </nav>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="flex justify-between items-center mb-8">
            <div>
                <h1 class="text-3xl font-bold text-white"><%= guild.name %></h1>
                <p class="text-gray-400">Economy Shop</p>
            </div>
            <div class="flex space-x-2">
                <a href="/economy/<%= guild.id %>" class="bg-gray-700 hover:bg-gray-600 text-white px-4 py-2 rounded-lg">Back to Economy</a>
                <a href="/overview/<%= guild.id %>" class="bg-gray-700 hover:bg-gray-600 text-white px-4 py-2 rounded-lg">Overview</a>
            </div>
        </div>

        <div class="bg-gray-800 rounded-xl p-6 border border-gray-700 mb-8">
            <h2 class="text-xl font-semibold text-white mb-6">Add Shop Item</h2>
            <form id="addItemForm" class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <div>
                    <label for="name" class="block text-sm font-medium text-gray-300 mb-2">Item Name</label>
                    <input type="text" id="name" name="name" required maxlength="100"
                           class="w-full bg-gray-700 border border-gray-600 rounded-lg px-4 py-2 text-white placeholder-gray-400 focus:border-purple-500 focus:outline-none focus:ring-1 focus:ring-purple-500"
                           placeholder="Custom Role">
                </div>

                <div>
                    <label for="description" class="block text-sm font-medium text-gray-300 mb-2">Description</label>
                    <textarea id="description" name="description" rows="2"
                              class="w-full bg-gray-700 border border-gray-600 rounded-lg px-4 py-2 text-white placeholder-gray-400 focus:border-purple-500 focus:outline-none focus:ring-1 focus:ring-purple-500"
                              placeholder="A custom colored role for your profile"></textarea>
                </div>

                <div>
                    <label for="price" class="block text-sm font-medium text-gray-300 mb-2">Price</label>
                    <input type="number" id="price" name="price" min="1" required
                           class="w-full bg-gray-700 border border-gray-600 rounded-lg px-4 py-2 text-white placeholder-gray-400 focus:border-purple-500 focus:outline-none focus:ring-1 focus:ring-purple-500"
                           placeholder="5000">
                </div>

                <div>
                    <label for="type" class="block text-sm font-medium text-gray-300 mb-2">Type</label>
                    <select id="type" name="type"
                            class="w-full bg-gray-700 border border-gray-600 rounded-lg px-4 py-2 text-white focus:border-purple-500 focus:outline-none focus:ring-1 focus:ring-purple-500">
                        <option value="role">Role</option>
                        <option value="item">Item</option>
                        <option value="command">Command</option>
                    </select>
                </div>

                <div>
                    <label for="roleId" class="block text-sm font-medium text-gray-300 mb-2">Role ID (for role type)</label>
                    <input type="text" id="roleId" name="roleId"
                           class="w-full bg-gray-700 border border-gray-600 rounded-lg px-4 py-2 text-white placeholder-gray-400 focus:border-purple-500 focus:outline-none focus:ring-1 focus:ring-purple-500"
                           placeholder="Role ID">
                </div>

                <div>
                    <label for="stock" class="block text-sm font-medium text-gray-300 mb-2">Stock (0 = unlimited)</label>
                    <input type="number" id="stock" name="stock" min="0" value="0"
                           class="w-full bg-gray-700 border border-gray-600 rounded-lg px-4 py-2 text-white placeholder-gray-400 focus:border-purple-500 focus:outline-none focus:ring-1 focus:ring-purple-500">
                </div>

                <div>
                    <label for="requiredLevel" class="block text-sm font-medium text-gray-300 mb-2">Required Level</label>
                    <input type="number" id="requiredLevel" name="requiredLevel" min="0" value="0"
                           class="w-full bg-gray-700 border border-gray-600 rounded-lg px-4 py-2 text-white placeholder-gray-400 focus:border-purple-500 focus:outline-none focus:ring-1 focus:ring-purple-500">
                </div>

                <div>
                    <label for="cooldown" class="block text-sm font-medium text-gray-300 mb-2">Cooldown (seconds, 0 = none)</label>
                    <input type="number" id="cooldown" name="cooldown" min="0" value="0"
                           class="w-full bg-gray-700 border border-gray-600 rounded-lg px-4 py-2 text-white placeholder-gray-400 focus:border-purple-500 focus:outline-none focus:ring-1 focus:ring-purple-500">
                </div>

                <div class="md:col-span-2 flex justify-end">
                    <button type="submit" class="bg-purple-600 hover:bg-purple-700 text-white px-6 py-2 rounded-lg font-medium transition-colors">Add Item</button>
                </div>
            </form>
        </div>

        <div class="bg-gray-800 rounded-xl p-6 border border-gray-700">
            <h2 class="text-xl font-semibold text-white mb-6">Shop Items</h2>
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead>
                        <tr class="text-left text-gray-400 border-b border-gray-700">
                            <th class="pb-3 px-2">Name</th>
                            <th class="pb-3 px-2">Type</th>
                            <th class="pb-3 px-2">Price</th>
                            <th class="pb-3 px-2">Stock</th>
                            <th class="pb-3 px-2">Level Req</th>
                            <th class="pb-3 px-2">Cooldown</th>
                            <th class="pb-3 px-2">Purchases</th>
                            <th class="pb-3 px-2">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-700">
                        <% if (shopItems && shopItems.length > 0) { %>
                            <% shopItems.forEach(item => { %>
                                <tr class="hover:bg-gray-700">
                                    <td class="py-3 px-2 font-medium text-white"><%= item.name %></td>
                                    <td class="py-3 px-2">
                                        <span class="px-2 py-1 bg-gray-700 text-gray-300 text-xs rounded"><%= item.type %></span>
                                    </td>
                                    <td class="py-3 px-2 text-yellow-400"><%= item.price %> 🪙</td>
                                    <td class="py-3 px-2"><%= item.stock > 0 ? item.stock : '∞' %></td>
                                    <td class="py-3 px-2"><%= item.requiredLevel || 0 %></td>
                                    <td class="py-3 px-2"><%= item.cooldown ? item.cooldown + 's' : 'None' %></td>
                                    <td class="py-3 px-2"><%= item.purchases || 0 %></td>
                                    <td class="py-3 px-2">
                                        <button class="delete-item bg-red-600 hover:bg-red-700 text-white px-3 py-1 rounded text-sm" data-id="<%= item.id %>">Delete</button>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="8" class="py-8 text-center text-gray-500">No shop items configured</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <footer class="bg-gray-800 border-t border-gray-700 py-8">
        <div class="max-w-7xl mx-auto px-4 text-center text-gray-500">
            <p>StellarSentry - Discord Bot with Dashboard</p>
        </div>
    </footer>

    <script>
        const guildId = '<%= guild.id %>';
        const csrfToken = '<%= csrfToken %>';

        document.getElementById('addItemForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(e.target);
            const data = {};
            formData.forEach((value, key) => {
                if (key !== '_csrf') data[key] = value;
            });
            data.price = parseInt(data.price) || 0;
            data.stock = parseInt(data.stock) || 0;
            data.requiredLevel = parseInt(data.requiredLevel) || 0;
            data.cooldown = parseInt(data.cooldown) || 0;
            data.roleId = data.roleId || null;

            try {
                const response = await fetch(`/economy/${guildId}/shop`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-Token': csrfToken
                    },
                    body: JSON.stringify(data)
                });
                const result = await response.json();
                if (result.success) {
                    alert('Item added!');
                    location.reload();
                } else {
                    alert('Failed: ' + (result.error || 'Unknown error'));
                }
            } catch (err) {
                alert('Error: ' + err.message);
            }
        });

        document.querySelectorAll('.delete-item').forEach(btn => {
            btn.addEventListener('click', async () => {
                if (!confirm('Delete this shop item?')) return;
                const id = btn.dataset.id;
                try {
                    const response = await fetch(`/economy/${guildId}/shop/${id}`, {
                        method: 'DELETE',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-CSRF-Token': csrfToken
                        }
                    });
                    const data = await response.json();
                    if (data.success) {
                        location.reload();
                    } else {
                        alert('Failed: ' + (data.error || 'Unknown error'));
                    }
                } catch (err) {
                    alert('Error: ' + err.message);
                }
            });
        });
    </script>
</body>
</html>