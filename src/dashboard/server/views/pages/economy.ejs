<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - StellarSentry</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-900 text-white min-h-screen">
    <nav class="bg-gray-800 border-b border-gray-700">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex items-center">
                    <a href="/guilds" class="text-xl font-bold text-purple-400">StellarSentry</a>
                    <span class="mx-2 text-gray-500">/</span>
                    <a href="/overview/<%= guild.id %>" class="text-purple-400 font-semibold"><%= guild.name %></a>
                    <span class="mx-2 text-gray-500">/</span>
                    <span class="text-gray-300">Economy</span>
                </div>
                <div class="flex items-center space-x-4">
                    <a href="/guilds" class="text-gray-300 hover:text-white">Dashboard</a>
                    <a href="/auth/logout" class="bg-purple-600 hover:bg-purple-700 text-white px-4 py-2 rounded-lg">Logout</a>
                </div>
            </div>
        </div>
    </nav>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="flex justify-between items-center mb-8">
            <div>
                <h1 class="text-3xl font-bold text-white"><%= guild.name %></h1>
                <p class="text-gray-400">Economy System</p>
            </div>
            <div class="flex space-x-2">
                <a href="/overview/<%= guild.id %>" class="bg-gray-700 hover:bg-gray-600 text-white px-4 py-2 rounded-lg">Overview</a>
                <a href="/settings/<%= guild.id %>" class="bg-gray-700 hover:bg-gray-600 text-white px-4 py-2 rounded-lg">Settings</a>
                <a href="/economy/<%= guild.id %>/shop" class="bg-purple-600 hover:bg-purple-700 text-white px-4 py-2 rounded-lg">Shop</a>
            </div>
        </div>

        <div class="bg-gray-800 rounded-xl p-6 border border-gray-700">
            <h2 class="text-xl font-semibold text-white mb-6">Economy Overview</h2>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
                <div class="bg-gray-700 rounded-lg p-6 border border-gray-600">
                    <p class="text-gray-400 text-sm">Currency Name</p>
                    <p class="text-2xl font-bold text-yellow-400"><%= economy?.currency?.name || 'Coins' %></p>
                </div>
                <div class="bg-gray-700 rounded-lg p-6 border border-gray-600">
                    <p class="text-gray-400 text-sm">Currency Symbol</p>
                    <p class="text-2xl font-bold text-yellow-400"><%= economy?.currency?.symbol || '🪙' %></p>
                </div>
                <div class="bg-gray-700 rounded-lg p-6 border border-gray-600">
                    <p class="text-gray-400 text-sm">Starting Balance</p>
                    <p class="text-2xl font-bold text-green-400"><%= economy?.startingBalance || 100 %> <%= economy?.currency?.symbol || '🪙' %></p>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
                <div class="bg-gray-700 rounded-lg p-6 border border-gray-600">
                    <p class="text-gray-400 text-sm">Daily Reward</p>
                    <p class="text-2xl font-bold text-blue-400"><%= economy?.daily?.amount || 500 %> <%= economy?.currency?.symbol || '🪙' %></p>
                </div>
                <div class="bg-gray-700 rounded-lg p-6 border border-gray-600">
                    <p class="text-gray-400 text-sm">Work Reward (min-max)</p>
                    <p class="text-2xl font-bold text-blue-400"><%= economy?.work?.min || 50 %> - <%= economy?.work?.max || 200 %> <%= economy?.currency?.symbol || '🪙' %></p>
                </div>
                <div class="bg-gray-700 rounded-lg p-6 border border-gray-600">
                    <p class="text-gray-400 text-sm">Work Cooldown</p>
                    <p class="text-2xl font-bold text-blue-400"><%= economy?.work?.cooldown || 3600 %>s</p>
                </div>
            </div>

            <a href="/economy/<%= guild.id %>/shop" class="inline-block bg-purple-600 hover:bg-purple-700 text-white px-6 py-3 rounded-lg font-medium transition-colors">Manage Shop →</a>
        </div>
    </main>

    <footer class="bg-gray-800 border-t border-gray-700 py-8">
        <div class="max-w-7xl mx-auto px-4 text-center text-gray-500">
            <p>StellarSentry - Discord Bot with Dashboard</p>
        </div>
    </footer>
</body>
</html>