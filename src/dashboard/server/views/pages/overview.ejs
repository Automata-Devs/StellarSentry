<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - StellarSentry</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-900 text-white min-h-screen">
    <nav class="bg-gray-800 border-b border-gray-700">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex items-center">
                    <a href="/guilds" class="text-xl font-bold text-purple-400">StellarSentry</a>
                    <span class="mx-2 text-gray-500">/</span>
                    <a href="/overview/<%= guild.id %>" class="text-purple-400 font-semibold"><%= guild.name %></a>
                </div>
                <div class="flex items-center space-x-4">
                    <a href="/guilds" class="text-gray-300 hover:text-white">Dashboard</a>
                    <a href="/auth/logout" class="bg-purple-600 hover:bg-purple-700 text-white px-4 py-2 rounded-lg">Logout</a>
                </div>
            </div>
        </div>
    </nav>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="flex justify-between items-center mb-8">
            <div>
                <h1 class="text-3xl font-bold text-white"><%= guild.name %></h1>
                <p class="text-gray-400">Server ID: <%= guild.id %></p>
            </div>
            <div class="flex space-x-2">
                <a href="/commands/<%= guild.id %>" class="bg-purple-600 hover:bg-purple-700 text-white px-4 py-2 rounded-lg">Commands</a>
                <a href="/settings/<%= guild.id %>" class="bg-gray-700 hover:bg-gray-600 text-white px-4 py-2 rounded-lg">Settings</a>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
            <div class="bg-gray-800 rounded-xl p-6 border border-gray-700">
                <p class="text-gray-400 text-sm">Total Members</p>
                <p class="text-3xl font-bold text-white"><%= stats.memberCount %></p>
            </div>
            <div class="bg-gray-800 rounded-xl p-6 border border-gray-700">
                <p class="text-gray-400 text-sm">Bots</p>
                <p class="text-3xl font-bold text-purple-400"><%= stats.botCount %></p>
            </div>
            <div class="bg-gray-800 rounded-xl p-6 border border-gray-700">
                <p class="text-gray-400 text-sm">Online</p>
                <p class="text-3xl font-bold text-green-400"><%= stats.onlineCount %></p>
            </div>
            <div class="bg-gray-800 rounded-xl p-6 border border-gray-700">
                <p class="text-gray-400 text-sm">Channels</p>
                <p class="text-3xl font-bold text-blue-400"><%= stats.textChannels + stats.voiceChannels %></p>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
            <div class="bg-gray-800 rounded-xl p-6 border border-gray-700">
                <h2 class="text-xl font-semibold text-white mb-4">Top Members (Leveling)</h2>
                <% if (topMembers && topMembers.length > 0) { %>
                    <div class="space-y-3">
                        <% topMembers.slice(0, 5).forEach((member, index) => { %>
                            <div class="flex items-center justify-between p-3 bg-gray-700 rounded-lg">
                                <div class="flex items-center space-x-3">
                                    <span class="text-lg font-bold text-purple-400">#<%= index + 1 %></span>
                                    <div>
                                        <p class="font-medium text-white"><%= member.username || 'Unknown' %></p>
                                        <p class="text-sm text-gray-400">Level <%= member.leveling?.level || 0 %> · <%= member.leveling?.xp || 0 %> XP</p>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <p class="text-gray-400 text-center py-8">No leveling data available</p>
                <% } %>
            </div>

            <div class="bg-gray-800 rounded-xl p-6 border border-gray-700">
                <h2 class="text-xl font-semibold text-white mb-4">Recent Activity</h2>
                <% if (recentLogs && recentLogs.length > 0) { %>
                    <div class="space-y-3 max-h-64 overflow-y-auto">
                        <% recentLogs.forEach(log => { %>
                            <div class="p-3 bg-gray-700 rounded-lg border border-gray-600">
                                <div class="flex items-center justify-between">
                                    <div class="flex items-center space-x-2">
                                        <span class="text-sm font-medium text-white"><%= log.eventType || 'Activity' %></span>
                                        <span class="text-xs text-gray-400"><%= log.user?.username || 'Unknown' %></span>
                                    </div>
                                    <span class="text-xs text-gray-500"><%= new Date(log.createdAt).toLocaleString() %></span>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <p class="text-gray-400 text-center py-8">No recent activity</p>
                <% } %>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <a href="/commands/<%= guild.id %>" class="block bg-gray-800 rounded-xl p-6 border border-gray-700 hover:border-purple-500 transition-colors">
                <h3 class="text-lg font-semibold text-white mb-2">Commands</h3>
                <p class="text-gray-400">Manage bot commands and permissions</p>
            </a>
            <a href="/moderation/<%= guild.id %>" class="block bg-gray-800 rounded-xl p-6 border border-gray-700 hover:border-purple-500 transition-colors">
                <h3 class="text-lg font-semibold text-white mb-2">Moderation</h3>
                <p class="text-gray-400">View logs and configure moderation</p>
            </a>
            <a href="/welcome/<%= guild.id %>" class="block bg-gray-800 rounded-xl p-6 border border-gray-700 hover:border-purple-500 transition-colors">
                <h3 class="text-lg font-semibold text-white mb-2">Welcome</h3>
                <p class="text-gray-400">Configure welcome/leave messages</p>
            </a>
        </div>
    </main>

    <footer class="bg-gray-800 border-t border-gray-700 py-8">
        <div class="max-w-7xl mx-auto px-4 text-center text-gray-500">
            <p>StellarSentry - Discord Bot with Dashboard</p>
        </div>
    </footer>
</body>
</html>