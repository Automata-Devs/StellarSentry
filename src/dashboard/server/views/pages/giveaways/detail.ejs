<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - StellarSentry</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-900 text-white min-h-screen">
    <nav class="bg-gray-800 border-b border-gray-700">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex items-center">
                    <a href="/guilds" class="text-xl font-bold text-purple-400">StellarSentry</a>
                    <span class="mx-2 text-gray-500">/</span>
                    <a href="/overview/<%= guild.id %>" class="text-purple-400 font-semibold"><%= guild.name %></a>
                    <span class="mx-2 text-gray-500">/</span>
                    <a href="/giveaways/<%= guild.id %>" class="text-gray-400 hover:text-white">Giveaways</a>
                    <span class="mx-2 text-gray-500">/</span>
                    <span class="text-gray-300"><%= giveaway.prize %></span>
                </div>
                <div class="flex items-center space-x-4">
                    <a href="/guilds" class="text-gray-300 hover:text-white">Dashboard</a>
                    <a href="/auth/logout" class="bg-purple-600 hover:bg-purple-700 text-white px-4 py-2 rounded-lg">Logout</a>
                </div>
            </div>
        </div>
    </nav>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="flex justify-between items-center mb-8">
            <div>
                <h1 class="text-3xl font-bold text-white"><%= giveaway.prize %></h1>
                <p class="text-gray-400">Giveaway Details</p>
            </div>
            <div class="flex space-x-2">
                <a href="/giveaways/<%= guild.id %>" class="bg-gray-700 hover:bg-gray-600 text-white px-4 py-2 rounded-lg">Back to Giveaways</a>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
            <div class="lg:col-span-2 bg-gray-800 rounded-xl p-6 border border-gray-700">
                <h2 class="text-xl font-semibold text-white mb-4">Giveaway Information</h2>
                <div class="space-y-4 text-sm">
                    <div class="flex justify-between py-2 border-b border-gray-700">
                        <span class="text-gray-400">Status</span>
                        <span class="px-2 py-1 rounded text-xs font-medium
                            <%= giveaway.status === 'running' ? 'bg-green-900 text-green-300' : '' %>
                            <%= giveaway.status === 'ended' ? 'bg-gray-700 text-gray-400' : '' %>
                            <%= giveaway.status === 'cancelled' ? 'bg-red-900 text-red-300' : '' %>
                        "><%= giveaway.status %></span>
                    </div>
                    <div class="flex justify-between py-2 border-b border-gray-700">
                        <span class="text-gray-400">Winners</span>
                        <span class="font-medium text-white"><%= giveaway.winners %></span>
                    </div>
                    <div class="flex justify-between py-2 border-b border-gray-700">
                        <span class="text-gray-400">Host</span>
                        <span class="font-medium text-white"><%= giveaway.host?.username || giveaway.hostId %></span>
                    </div>
                    <div class="flex justify-between py-2 border-b border-gray-700">
                        <span class="text-gray-400">Ends At</span>
                        <span class="font-medium text-white"><%= new Date(giveaway.endsAt).toLocaleString() %></span>
                    </div>
                    <div class="flex justify-between py-2 border-b border-gray-700">
                        <span class="text-gray-400">Created At</span>
                        <span class="font-medium text-white"><%= new Date(giveaway.createdAt).toLocaleString() %></span>
                    </div>
                    <div class="flex justify-between py-2 border-b border-gray-700">
                        <span class="text-gray-400">Total Entries</span>
                        <span class="font-medium text-white"><%= giveaway.entries?.length || 0 %></span>
                    </div>
                    <% if (giveaway.endedAt) { %>
                        <div class="flex justify-between py-2 border-b border-gray-700">
                            <span class="text-gray-400">Ended At</span>
                            <span class="font-medium text-white"><%= new Date(giveaway.endedAt).toLocaleString() %></span>
                        </div>
                        <div class="flex justify-between py-2 border-b border-gray-700">
                            <span class="text-gray-400">Winners</span>
                            <span class="font-medium text-white"><%= giveaway.winnersList?.map(w => w.username || w.id).join(', ') || 'None' %></span>
                        </div>
                    <% } %>
                    <div class="flex justify-between py-2 border-b border-gray-700">
                        <span class="text-gray-400">Requirements</span>
                        <span class="font-medium text-white">
                            <%= giveaway.requirements?.requiredRole ? 'Role: ' + giveaway.requirements.requiredRole : '' %>
                            <%= giveaway.requirements?.requiredLevel ? ' | Level: ' + giveaway.requirements.requiredLevel : '' %>
                            <%= giveaway.requirements?.accountAge ? ' | Account Age: ' + giveaway.requirements.accountAge + 'd' : '' %>
                            <%= giveaway.requirements?.serverAge ? ' | Server Age: ' + giveaway.requirements.serverAge + 'd' : '' %>
                        </span>
                    </div>
                    <% if (giveaway.blacklistedRoles && giveaway.blacklistedRoles.length > 0) { %>
                        <div class="flex justify-between py-2 border-b border-gray-700">
                            <span class="text-gray-400">Blacklisted Roles</span>
                            <span class="font-medium text-white"><%= giveaway.blacklistedRoles.join(', ') %></span>
                        </div>
                    <% } %>
                </div>
            </div>

            <div class="space-y-4">
                <div class="bg-gray-800 rounded-xl p-6 border border-gray-700">
                    <h3 class="text-lg font-semibold text-white mb-4">Actions</h3>
                    <div class="space-y-2">
                        <% if (giveaway.status === 'running') { %>
                            <button id="endBtn" class="w-full bg-red-600 hover:bg-red-700 text-white py-2 rounded-lg" data-id="<%= giveaway.giveawayId %>">End Giveaway</button>
                        <% } %>
                        <% if (giveaway.status === 'ended' || giveaway.status === 'cancelled') { %>
                            <button id="rerollBtn" class="w-full bg-purple-600 hover:bg-purple-700 text-white py-2 rounded-lg" data-id="<%= giveaway.giveawayId %>">Reroll Winners</button>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>

        <div class="bg-gray-800 rounded-xl p-6 border border-gray-700">
            <h2 class="text-xl font-semibold text-white mb-4">Entries (<%= giveaway.entries?.length || 0 %>)</h2>
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead>
                        <tr class="text-left text-gray-400 border-b border-gray-700">
                            <th class="pb-3 px-2">User</th>
                            <th class="pb-3 px-2">Entered At</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-700">
                        <% if (giveaway.entries && giveaway.entries.length > 0) { %>
                            <% giveaway.entries.forEach(entry => { %>
                                <tr class="hover:bg-gray-700">
                                    <td class="py-3 px-2"><%= entry.user?.username || entry.userId %></td>
                                    <td class="py-3 px-2 text-sm text-gray-400"><%= new Date(entry.enteredAt).toLocaleString() %></td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="2" class="py-8 text-center text-gray-500">No entries yet</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <footer class="bg-gray-800 border-t border-gray-700 py-8">
        <div class="max-w-7xl mx-auto px-4 text-center text-gray-500">
            <p>StellarSentry - Discord Bot with Dashboard</p>
        </div>
    </footer>

    <script>
        const guildId = '<%= guild.id %>';
        const giveawayId = '<%= giveaway.giveawayId %>';
        const csrfToken = '<%= csrfToken %>';

        document.getElementById('endBtn')?.addEventListener('click', async () => {
            if (!confirm('End this giveaway early?')) return;
            await handleAction('end');
        });

        document.getElementById('rerollBtn')?.addEventListener('click', async () => {
            const winners = prompt('Number of winners to reroll:', '1');
            if (winners) {
                await handleAction('reroll', { winners: parseInt(winners) || 1 });
            }
        });

        async function handleAction(action, extraData = {}) {
            try {
                const response = await fetch(`/giveaways/${guildId}/${giveawayId}/${action}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-Token': csrfToken
                    },
                    body: JSON.stringify(extraData)
                });
                const data = await response.json();
                if (data.success) {
                    location.reload();
                } else {
                    alert('Failed: ' + (data.error || 'Unknown error'));
                }
            } catch (err) {
                alert('Error: ' + err.message);
            }
        }
    </script>
</body>
</html>