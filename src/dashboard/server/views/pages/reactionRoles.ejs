<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - StellarSentry</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-900 text-white min-h-screen">
    <nav class="bg-gray-800 border-b border-gray-700">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex items-center">
                    <a href="/guilds" class="text-xl font-bold text-purple-400">StellarSentry</a>
                    <span class="mx-2 text-gray-500">/</span>
                    <a href="/overview/<%= guild.id %>" class="text-purple-400 font-semibold"><%= guild.name %></a>
                    <span class="mx-2 text-gray-500">/</span>
                    <span class="text-gray-300">Reaction Roles</span>
                </div>
                <div class="flex items-center space-x-4">
                    <a href="/guilds" class="text-gray-300 hover:text-white">Dashboard</a>
                    <a href="/auth/logout" class="bg-purple-600 hover:bg-purple-700 text-white px-4 py-2 rounded-lg">Logout</a>
                </div>
            </div>
        </div>
    </nav>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="flex justify-between items-center mb-8">
            <div>
                <h1 class="text-3xl font-bold text-white"><%= guild.name %></h1>
                <p class="text-gray-400">Reaction Roles Management</p>
            </div>
            <div class="flex space-x-2">
                <a href="/overview/<%= guild.id %>" class="bg-gray-700 hover:bg-gray-600 text-white px-4 py-2 rounded-lg">Overview</a>
                <a href="/settings/<%= guild.id %>" class="bg-gray-700 hover:bg-gray-600 text-white px-4 py-2 rounded-lg">Settings</a>
            </div>
        </div>

        <div class="bg-gray-800 rounded-xl p-6 border border-gray-700 mb-8">
            <h2 class="text-xl font-semibold text-white mb-6">Create Reaction Role</h2>
            <form id="createReactionRoleForm" class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <div class="md:col-span-2">
                    <label for="messageId" class="block text-sm font-medium text-gray-300 mb-2">Message ID</label>
                    <input type="text" id="messageId" name="messageId" required
                           class="w-full bg-gray-700 border border-gray-600 rounded-lg px-4 py-2 text-white placeholder-gray-400 focus:border-purple-500 focus:outline-none focus:ring-1 focus:ring-purple-500"
                           placeholder="Right-click message → Copy ID">
                </div>

                <div class="md:col-span-2">
                    <label for="channelId" class="block text-sm font-medium text-gray-300 mb-2">Channel ID</label>
                    <input type="text" id="channelId" name="channelId" required
                           class="w-full bg-gray-700 border border-gray-600 rounded-lg px-4 py-2 text-white placeholder-gray-400 focus:border-purple-500 focus:outline-none focus:ring-1 focus:ring-purple-500"
                           placeholder="Right-click channel → Copy ID">
                </div>

                <div>
                    <label for="emoji" class="block text-sm font-medium text-gray-300 mb-2">Emoji</label>
                    <input type="text" id="emoji" name="emoji" required
                           class="w-full bg-gray-700 border border-gray-600 rounded-lg px-4 py-2 text-white placeholder-gray-400 focus:border-purple-500 focus:outline-none focus:ring-1 focus:ring-purple-500"
                           placeholder="🎮 or custom:123456789012345678">
                </div>

                <div>
                    <label for="roleId" class="block text-sm font-medium text-gray-300 mb-2">Role ID</label>
                    <input type="text" id="roleId" name="roleId" required
                           class="w-full bg-gray-700 border border-gray-600 rounded-lg px-4 py-2 text-white placeholder-gray-400 focus:border-purple-500 focus:outline-none focus:ring-1 focus:ring-purple-500"
                           placeholder="Right-click role → Copy ID">
                </div>

                <div>
                    <label for="type" class="block text-sm font-medium text-gray-300 mb-2">Type</label>
                    <select id="type" name="type"
                            class="w-full bg-gray-700 border border-gray-600 rounded-lg px-4 py-2 text-white focus:border-purple-500 focus:outline-none focus:ring-1 focus:ring-purple-500">
                        <option value="normal">Normal (add/remove)</option>
                        <option value="once">Once (add only)</option>
                        <option value="remove">Remove only</option>
                        <option value="toggle">Toggle</option>
                    </select>
                </div>

                <div>
                    <label for="maxRoles" class="block text-sm font-medium text-gray-300 mb-2">Max Roles per User (0 = unlimited)</label>
                    <input type="number" id="maxRoles" name="maxRoles" min="0" value="0"
                           class="w-full bg-gray-700 border border-gray-600 rounded-lg px-4 py-2 text-white placeholder-gray-400 focus:border-purple-500 focus:outline-none focus:ring-1 focus:ring-purple-500">
                </div>

                <div class="md:col-span-2 flex justify-end">
                    <button type="submit" class="bg-purple-600 hover:bg-purple-700 text-white px-6 py-2 rounded-lg font-medium transition-colors">Create Reaction Role</button>
                </div>
            </form>
        </div>

        <div class="bg-gray-800 rounded-xl p-6 border border-gray-700">
            <h2 class="text-xl font-semibold text-white mb-6">Existing Reaction Roles</h2>
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead>
                        <tr class="text-left text-gray-400 border-b border-gray-700">
                            <th class="pb-3 px-2">ID</th>
                            <th class="pb-3 px-2">Message</th>
                            <th class="pb-3 px-2">Channel</th>
                            <th class="pb-3 px-2">Emoji</th>
                            <th class="pb-3 px-2">Role</th>
                            <th class="pb-3 px-2">Type</th>
                            <th class="pb-3 px-2">Max/User</th>
                            <th class="pb-3 px-2">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-700">
                        <% if (reactionRoles && reactionRoles.length > 0) { %>
                            <% reactionRoles.forEach(rr => { %>
                                <tr class="hover:bg-gray-700">
                                    <td class="py-3 px-2 font-mono text-purple-400">#<%= rr.id %></td>
                                    <td class="py-3 px-2 font-mono text-sm"><%= rr.messageId %></td>
                                    <td class="py-3 px-2 font-mono text-sm"><%= rr.channelId %></td>
                                    <td class="py-3 px-2 text-2xl"><%= rr.emoji %></td>
                                    <td class="py-3 px-2"><%= rr.role?.name || rr.roleId %></td>
                                    <td class="py-3 px-2">
                                        <span class="px-2 py-1 bg-gray-700 text-gray-300 text-xs rounded"><%= rr.type %></span>
                                    </td>
                                    <td class="py-3 px-2"><%= rr.maxRoles || '∞' %></td>
                                    <td class="py-3 px-2">
                                        <button class="delete-rr bg-red-600 hover:bg-red-700 text-white px-3 py-1 rounded text-sm" data-id="<%= rr.id %>">Delete</button>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="8" class="py-8 text-center text-gray-500">No reaction roles configured</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <footer class="bg-gray-800 border-t border-gray-700 py-8">
        <div class="max-w-7xl mx-auto px-4 text-center text-gray-500">
            <p>StellarSentry - Discord Bot with Dashboard</p>
        </div>
    </footer>

    <script>
        const guildId = '<%= guild.id %>';
        const csrfToken = '<%= csrfToken %>';

        document.getElementById('createReactionRoleForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(e.target);
            const data = {};
            formData.forEach((value, key) => {
                if (key !== '_csrf') data[key] = value;
            });
            data.maxRoles = parseInt(data.maxRoles) || 0;

            try {
                const response = await fetch(`/reactionRoles/${guildId}/create`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-Token': csrfToken
                    },
                    body: JSON.stringify(data)
                });
                const result = await response.json();
                if (result.success) {
                    alert('Reaction role created!');
                    location.reload();
                } else {
                    alert('Failed: ' + (result.error || 'Unknown error'));
                }
            } catch (err) {
                alert('Error: ' + err.message);
            }
        });

        document.querySelectorAll('.delete-rr').forEach(btn => {
            btn.addEventListener('click', async () => {
                if (!confirm('Delete this reaction role?')) return;
                const id = btn.dataset.id;
                try {
                    const response = await fetch(`/reactionRoles/${guildId}/${id}`, {
                        method: 'DELETE',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-CSRF-Token': csrfToken
                        }
                    });
                    const data = await response.json();
                    if (data.success) {
                        location.reload();
                    } else {
                        alert('Failed: ' + (data.error || 'Unknown error'));
                    }
                } catch (err) {
                    alert('Error: ' + err.message);
                }
            });
        });
    </script>
</body>
</html>