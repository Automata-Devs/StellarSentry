<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - StellarSentry</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-900 text-white min-h-screen">
    <nav class="bg-gray-800 border-b border-gray-700">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex items-center">
                    <a href="/guilds" class="text-xl font-bold text-purple-400">StellarSentry</a>
                    <span class="mx-2 text-gray-500">/</span>
                    <a href="/overview/<%= guild.id %>" class="text-purple-400 font-semibold"><%= guild.name %></a>
                    <span class="mx-2 text-gray-500">/</span>
                    <span class="text-gray-300">Tickets</span>
                </div>
                <div class="flex items-center space-x-4">
                    <a href="/guilds" class="text-gray-300 hover:text-white">Dashboard</a>
                    <a href="/auth/logout" class="bg-purple-600 hover:bg-purple-700 text-white px-4 py-2 rounded-lg">Logout</a>
                </div>
            </div>
        </div>
    </nav>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="flex justify-between items-center mb-8">
            <div>
                <h1 class="text-3xl font-bold text-white"><%= guild.name %></h1>
                <p class="text-gray-400">Ticket System</p>
            </div>
            <div class="flex space-x-2">
                <a href="/overview/<%= guild.id %>" class="bg-gray-700 hover:bg-gray-600 text-white px-4 py-2 rounded-lg">Overview</a>
                <a href="/settings/<%= guild.id %>" class="bg-gray-700 hover:bg-gray-600 text-white px-4 py-2 rounded-lg">Settings</a>
            </div>
        </div>

        <div class="bg-gray-800 rounded-xl p-6 border border-gray-700">
            <div class="flex items-center justify-between mb-6">
                <h2 class="text-xl font-semibold text-white">Tickets</h2>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead>
                        <tr class="text-left text-gray-400 border-b border-gray-700">
                            <th class="pb-3 px-2">ID</th>
                            <th class="pb-3 px-2">Subject</th>
                            <th class="pb-3 px-2">Type</th>
                            <th class="pb-3 px-2">Status</th>
                            <th class="pb-3 px-2">User</th>
                            <th class="pb-3 px-2">Created</th>
                            <th class="pb-3 px-2">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-700">
                        <% if (tickets && tickets.length > 0) { %>
                            <% tickets.forEach(ticket => { %>
                                <tr class="hover:bg-gray-700">
                                    <td class="py-3 px-2 font-mono text-purple-400">#<%= ticket.ticketId %></td>
                                    <td class="py-3 px-2"><%= ticket.subject %></td>
                                    <td class="py-3 px-2">
                                        <span class="px-2 py-1 bg-gray-700 text-gray-300 text-xs rounded"><%= ticket.type %></span>
                                    </td>
                                    <td class="py-3 px-2">
                                        <span class="px-2 py-1 rounded text-xs font-medium
                                            <%= ticket.status === 'open' ? 'bg-green-900 text-green-300' : '' %>
                                            <%= ticket.status === 'claimed' ? 'bg-blue-900 text-blue-300' : '' %>
                                            <%= ticket.status === 'in_progress' ? 'bg-yellow-900 text-yellow-300' : '' %>
                                            <%= ticket.status === 'waiting' ? 'bg-orange-900 text-orange-300' : '' %>
                                            <%= ticket.status === 'closed' ? 'bg-gray-700 text-gray-400' : '' %>
                                            <%= ticket.status === 'deleted' ? 'bg-red-900 text-red-300' : '' %>
                                        "><%= ticket.status %></span>
                                    </td>
                                    <td class="py-3 px-2"><%= ticket.user?.username || 'Unknown' %></td>
                                    <td class="py-3 px-2 text-sm text-gray-400"><%= new Date(ticket.createdAt).toLocaleDateString() %></td>
                                    <td class="py-3 px-2">
                                        <a href="/tickets/<%= guild.id %>/<%= ticket.ticketId %>" class="text-purple-400 hover:text-purple-300 text-sm">View</a>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="7" class="py-8 text-center text-gray-500">No tickets found</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <footer class="bg-gray-800 border-t border-gray-700 py-8">
        <div class="max-w-7xl mx-auto px-4 text-center text-gray-500">
            <p>StellarSentry - Discord Bot with Dashboard</p>
        </div>
    </footer>
</body>
</html>