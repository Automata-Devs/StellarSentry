<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - StellarSentry</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-900 text-white min-h-screen">
    <nav class="bg-gray-800 border-b border-gray-700">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex items-center">
                    <a href="/" class="text-xl font-bold text-purple-400">StellarSentry</a>
                </div>
                <div class="flex items-center space-x-4">
                    <% if (user) { %>
                        <a href="/guilds" class="text-gray-300 hover:text-white">Dashboard</a>
                        <a href="/auth/logout" class="bg-purple-600 hover:bg-purple-700 text-white px-4 py-2 rounded-lg">Logout</a>
                    <% } else { %>
                        <a href="/auth/login" class="bg-purple-600 hover:bg-purple-700 text-white px-4 py-2 rounded-lg">Login with Discord</a>
                    <% } %>
                </div>
            </div>
        </div>
    </nav>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
        <div class="text-center">
            <h1 class="text-5xl font-bold text-white mb-6">StellarSentry</h1>
            <p class="text-xl text-gray-300 mb-10 max-w-2xl mx-auto">
                A production-ready multi-purpose Discord bot with a beautiful web dashboard.
            </p>
            <% if (!user) { %>
                <a href="/auth/login" class="inline-block bg-purple-600 hover:bg-purple-700 text-white px-8 py-4 rounded-lg text-lg transition-colors">
                    Get Started - Login with Discord
                </a>
            <% } else { %>
                <a href="/guilds" class="inline-block bg-purple-600 hover:bg-purple-700 text-white px-8 py-4 rounded-lg text-lg transition-colors">
                    Go to Dashboard
                </a>
            <% } %>
        </div>

        <div class="mt-20 grid grid-cols-1 md:grid-cols-3 gap-8">
            <div class="bg-gray-800 rounded-xl p-6 border border-gray-700">
                <h3 class="text-xl font-semibold text-white mb-3">Moderation</h3>
                <p class="text-gray-400">Powerful moderation tools including warnings, bans, timeouts, and audit logs.</p>
            </div>
            <div class="bg-gray-800 rounded-xl p-6 border border-gray-700">
                <h3 class="text-xl font-semibold text-white mb-3">Music</h3>
                <p class="text-gray-400">High-quality music playback with Lavalink support and queue management.</p>
            </div>
            <div class="bg-gray-800 rounded-xl p-6 border border-gray-700">
                <h3 class="text-xl font-semibold text-white mb-3">Customization</h3>
                <p class="text-gray-400">Welcome messages, leveling, economy, reaction roles, and more.</p>
            </div>
        </div>
    </main>

    <footer class="bg-gray-800 border-t border-gray-700 py-8">
        <div class="max-w-7xl mx-auto px-4 text-center text-gray-500">
            <p>StellarSentry - Discord Bot with Dashboard</p>
        </div>
    </footer>
</body>
</html>